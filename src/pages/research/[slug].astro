---
import type { GetStaticPaths } from "astro";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ResourceLinks from "@components/ResourceLinks.astro";
import StatusBadge from "@components/StatusBadge.astro";
import ContactCTA from "@components/ContactCTA.astro";
import { researchProjects, researchLinks, researchStatus, projectPublication, publicationBibtex, type ResearchProject } from "@data/research";
export const getStaticPaths = (() => researchProjects.map(project => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;
type Props = { project: ResearchProject };
const { project } = Astro.props;
const paper = projectPublication(project);
const sections = [
    ["Problem", project.problem], ["Approach", project.approach], ["Research contribution", project.contribution],
    ["Authorship", project.authorship], ["Evaluation evidence", project.evidence], ["Scope & limitations", project.limitations],
    ["Reproduction", project.reproduction],
].filter((row): row is [string, string] => Boolean(row[1]));
const articleSchema = paper ? { "@context": "https://schema.org", "@type": "ScholarlyArticle", name: paper.title,
    author: paper.authors?.map(name => ({ "@type": "Person", name })), url: new URL(`/research/${project.slug}/`, Astro.site),
    ...(paper.status === "published" ? { datePublished: String(paper.year) } : {}),
    ...(paper.doi ? { sameAs: `https://doi.org/${paper.doi}` } : {}),
} : undefined;
---
<PageLayout title={`${project.title}: ${project.subtitle}`} description={project.summary}>
    {articleSchema && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
    <section class="pb-12 pt-28 md:pt-32"><Container size="xl">
        <a class="text-link text-sm" href="/research/">← All research</a>
        <div class="mt-6"><StatusBadge status={researchStatus(project)} /></div>
        <h1 class="page-heading mt-4 text-4xl md:text-5xl">{project.title}</h1>
        <p class="mt-3 max-w-3xl text-xl text-slate-600 dark:text-slate-300">{project.subtitle}</p>
        {paper && <div class="mt-5 max-w-3xl text-sm leading-relaxed"><p>{paper.authors?.join(", ")}</p><p class="mt-2 text-slate-600 dark:text-slate-400">{paper.venue}, {paper.year}. {paper.status === "accepted" ? "Accepted." : "Published."}{paper.presented ? " Presented at the conference." : ""}</p></div>}
        <ResourceLinks links={researchLinks(project)} context={project.title} class="mt-6" />
    </Container></section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800"><Container size="xl">
        <div class="max-w-3xl space-y-9">{sections.map(([title, text]) => <section><h2 class="text-2xl font-semibold text-slate-900 dark:text-white">{title}</h2><p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{text}</p></section>)}</div>
        {paper && <section class="mt-10 max-w-3xl"><h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Citation</h2><p class="mt-3 text-sm leading-relaxed">{paper.authors?.join(", ")}. “{paper.title}.” {paper.venue}, {paper.year}.{paper.status === "accepted" ? " Accepted." : ""}</p><details class="mt-4"><summary class="cursor-pointer font-semibold text-brand-700 dark:text-brand-400">BibTeX</summary><pre class="mt-3 overflow-x-auto rounded-lg bg-slate-50 p-4 text-xs dark:bg-slate-900"><code>{publicationBibtex(paper)}</code></pre></details></section>}
    </Container></section>
    <ContactCTA />
</PageLayout>
