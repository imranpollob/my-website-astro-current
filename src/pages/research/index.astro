---
import Container from "@components/Container.astro";
import ContactCTA from "@components/ContactCTA.astro";
import PublicationItem from "@components/PublicationItem.astro";
import ResearchCard from "@components/ResearchCard.astro";
import SectionHeader from "@components/SectionHeader.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { RESEARCH, SCHOLAR_URL } from "@consts";
import { publications, RESEARCH_VISION, researchProjects, researchDirections, researchAreas } from "@data/research";
const selected = publications.filter(p => p.group === "selected");
const earlier = publications.filter(p => p.group === "earlier").sort((a,b) => b.year-a.year);
---
<PageLayout title={RESEARCH.SEO_TITLE} description={RESEARCH.DESCRIPTION}>
    <section class="pb-10 pt-28 md:pt-32"><Container size="xl">
        <h1 class="page-heading text-4xl">Research</h1>
        <div class="mt-5 max-w-3xl space-y-3 leading-relaxed text-slate-600 dark:text-slate-300">{RESEARCH_VISION.map(text => <p>{text}</p>)}</div>
        <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold"><a class="text-link" href="#publications">Publications</a><a class="text-link" href="#projects">Research projects</a><a class="text-link" href="#directions">Future directions</a><a class="text-link" href="#areas">Research areas</a></nav>
    </Container></section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800"><Container size="xl">
        <SectionHeader id="publications" title="Publications" href={SCHOLAR_URL} linkText="Google Scholar" />
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Security & Decentralized Systems</h3>
        <ul class="mt-3 divide-y divide-slate-200 dark:divide-slate-800">{selected.map(publication => <PublicationItem publication={publication} />)}</ul>
        <h3 class="mt-10 text-lg font-semibold text-slate-900 dark:text-white">Earlier Publications</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Collaborative work in scientific workflows, applied machine learning, and embedded and networked systems.</p>
        <ul class="mt-3 divide-y divide-slate-200 dark:divide-slate-800">{earlier.map(publication => <PublicationItem publication={publication} />)}</ul>
    </Container></section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800"><Container size="xl">
        <SectionHeader id="projects" title="Research Projects" description="Problems, contributions, evaluation context, and available artifacts." />
        <div class="grid gap-5 md:grid-cols-2">{researchProjects.map(project => <ResearchCard project={project} />)}</div>
    </Container></section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800"><Container size="xl">
        <SectionHeader id="directions" title="Future Research Directions" description="Proposed investigations building on my current work; these are research questions, not completed results." />
        <div class="space-y-8 max-w-3xl">{researchDirections.map(direction => <article><h3 class="text-xl font-semibold text-slate-900 dark:text-white">{direction.title}</h3><p class="mt-2 font-medium">{direction.question}</p><p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-400">{direction.description}</p></article>)}</div>
    </Container></section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800"><Container size="xl">
        <SectionHeader id="areas" title="Research Areas" />
        <div class="grid gap-6 md:grid-cols-2">{researchAreas.map(area => <div><h3 class="font-semibold text-slate-900 dark:text-white">{area.title}</h3><p class="mt-2 text-sm">{area.description}</p><ul class="mt-3 flex flex-wrap gap-4 text-sm">{area.related.map(slug => <li><a class="text-link" href={`/research/${slug}/`}>{researchProjects.find(p => p.slug === slug)?.title}</a></li>)}</ul></div>)}</div>
    </Container></section>
    <ContactCTA />
</PageLayout>
