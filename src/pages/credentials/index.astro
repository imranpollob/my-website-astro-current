---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Certifications from "@components/Certifications.astro";
---
<PageLayout title="Professional Coursework & Credentials" description="Professional courses completed by Imran Pollob, with verifiable credentials.">
    <section class="pb-12 pt-28 md:pt-32"><Container size="xl"><h1 class="page-heading text-4xl md:text-5xl">Professional Coursework & Credentials</h1><p class="mt-5 max-w-2xl text-slate-600 dark:text-slate-400">Courses I have completed outside my degree, with links to verify each credential.</p><a class="text-link mt-4 inline-block" href="/research">See my research →</a></Container></section>
    <Certifications />
</PageLayout>
