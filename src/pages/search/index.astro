---
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import type { SearchItem } from "@components/ArrowCard";
import { SEARCH } from "@consts";
import { publications, researchProjects } from "@data/research";
import { projects } from "@data/projects";

const data: SearchItem[] = [
  ...researchProjects.map((project) => ({
    type: "research" as const,
    title: project.title,
    summary: project.summary,
    url: `/research#${project.slug}`,
    tags: project.tags,
  })),
  ...publications.map((paper) => ({
    type: "research" as const,
    title: paper.title,
    summary: paper.summary,
    url: `/research#${paper.slug}`,
    tags: [String(paper.year)],
  })),
  ...projects.map((project) => ({
    type: "project" as const,
    title: project.title,
    summary: project.description,
    url: project.liveUrl ?? project.githubUrl ?? "/projects",
    tags: [project.kind, ...(project.tags ?? [])],
  })),
];
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <h1 class="text-2xl md:text-3xl text-center animate page-heading">
      {SEARCH.TITLE}
    </h1>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search client:load data={data} />
    </div>
  </BottomLayout>
</PageLayout>

<style>
  :root {
    --pagefind-ui-primary: #000000;
    --pagefind-ui-text: #000000;
    --pagefind-ui-background: #ffffff;
  }

  html.dark {
    --pagefind-ui-primary: #ffffff;
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: #000000;
  }
</style>
