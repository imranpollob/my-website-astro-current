---
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import type { SearchItem } from "@components/ArrowCard";
import { SEARCH } from "@consts";
import { researchPapers } from "@data/research";
import projectsData from "../projects/projects.json";

type Project = (typeof projectsData.portfolio.projects)["Blockchain Engineering"][number];

const allProjects: Project[] = (Object.values(projectsData.portfolio.projects) as Project[][]).flat();

const data: SearchItem[] = [
  ...allProjects.map((project) => ({
    type: "project" as const,
    title: project.title,
    summary: project.description,
    url: project.url,
    tags: [project.category],
  })),
  ...researchPapers.map((paper) => ({
    type: "research" as const,
    title: paper.title,
    summary: paper.summary,
    url: `/research#${paper.slug}`,
    tags: [String(paper.year)],
  })),
];
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <div
      class="text-xl md:text-2xl lg:text-3xl text-center animate page-heading glass-panel"
    >
      {SEARCH.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search client:load data={data} />
    </div>
  </BottomLayout>
</PageLayout>

<style>
  :root {
    --pagefind-ui-primary: #000000;
    --pagefind-ui-text: #000000;
    --pagefind-ui-background: #ffffff;
  }

  html.dark {
    --pagefind-ui-primary: #ffffff;
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: #000000;
  }
</style>
