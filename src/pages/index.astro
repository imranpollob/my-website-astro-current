---
import Container from "@components/Container.astro";
import ContactCTA from "@components/ContactCTA.astro";
import ResearchCard from "@components/ResearchCard.astro";
import SectionHeader from "@components/SectionHeader.astro";
import ResourceLinks from "@components/ResourceLinks.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { PROFILE, SITE, SOCIALS } from "@consts";
import { featuredResearch, researchDirections } from "@data/research";
import { education, industryExperience, teaching, teachingAward } from "@data/experience";
import type { ResourceLink } from "@types";
const profiles: ResourceLink[] = SOCIALS.filter(s => s.ICON !== "email").map(s => ({ label: s.TEXT, href: s.HREF, icon: s.ICON === "google-scholar" ? "scholar" : s.ICON as "github" | "linkedin" }));
const personSchema = {
    "@context": "https://schema.org", "@type": "Person", name: PROFILE.NAME, alternateName: PROFILE.PUBLICATION_NAME,
    url: Astro.site, image: new URL(PROFILE.PHOTO, Astro.site), email: `mailto:${PROFILE.EMAIL}`,
    jobTitle: "Ph.D. Candidate in Computer Science", description: PROFILE.HEADLINE,
    affiliation: { "@type": "CollegeOrUniversity", name: PROFILE.AFFILIATION },
    alumniOf: [{ "@type": "CollegeOrUniversity", name: "Jahangirnagar University" }],
    knowsAbout: PROFILE.THEMES, sameAs: SOCIALS.filter(s => !s.HREF.startsWith("mailto:")).map(s => s.HREF),
};
---
<PageLayout description={SITE.DESCRIPTION}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <section class="pb-12 pt-28 md:pb-14 md:pt-32" aria-labelledby="hero-heading">
        <Container size="xl">
            <div class="grid items-center gap-8 md:grid-cols-[1fr_auto] md:gap-14">
                <div class="max-w-3xl">
                    <h1 id="hero-heading" class="text-4xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-5xl">{PROFILE.NAME}</h1>
                    <p class="mt-3 text-xl font-medium text-brand-700 dark:text-brand-400 md:text-2xl">{PROFILE.HEADLINE}</p>
                    <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">Ph.D. Candidate in Computer Science · {PROFILE.AFFILIATION}<br /><span class="text-slate-600 dark:text-slate-400">Expected graduation: {PROFILE.EXPECTED_GRADUATION}</span></p>
                    <p class="mt-5 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300">I study security and privacy in Ethereum accounts, smart contracts, and zero-knowledge applications. My work combines program analysis, adversarial evaluation, and protocol design to investigate how these systems behave under attack.</p>
                    <p class="mt-4 max-w-2xl border-l-2 border-brand-600 pl-3 text-sm font-medium text-slate-800 dark:text-slate-200">{PROFILE.JOB_MARKET}</p>
                    <div class="mt-6 flex flex-wrap gap-3">
                        <a href="/research#publications" class="rounded-md bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-brand-700 dark:hover:bg-brand-800">Research & Publications</a>
                        <a href={PROFILE.CV_URL} target="_blank" rel="noopener noreferrer" class="rounded-md border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 hover:border-brand-600 dark:border-slate-700 dark:text-white">Academic CV<span class="sr-only"> (PDF, opens in a new tab)</span></a>
                        <a href={`mailto:${PROFILE.EMAIL}`} class="rounded-md border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 hover:border-brand-600 dark:border-slate-700 dark:text-white">Email</a>
                    </div>
                    <ResourceLinks links={profiles} class="mt-5" />
                </div>
                <img src={PROFILE.PHOTO} alt={`Portrait of ${PROFILE.NAME}`} width="819" height="1024" class="hidden w-48 rounded-2xl border border-slate-200 object-cover shadow-sm dark:border-slate-800 md:block lg:w-56" />
            </div>
        </Container>
    </section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800 md:py-16" aria-labelledby="selected-research-heading">
        <Container size="xl">
            <SectionHeader id="selected-research-heading" title="Selected Research" description="Account authorization, privacy-preserving protocols, and security analysis." href="/research" linkText="All research & publications" />
            <div class="grid gap-5 md:grid-cols-2">{featuredResearch.map(project => <ResearchCard project={project} />)}</div>
        </Container>
    </section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800 md:py-16" aria-labelledby="directions-heading">
        <Container size="xl">
            <SectionHeader id="directions-heading" title="Research Directions" description="Questions shaping my next investigations." href="/research#directions" linkText="Read the research agenda" />
            <div class="grid gap-8 md:grid-cols-3">{researchDirections.map(direction => <div><h3 class="text-lg font-semibold text-slate-900 dark:text-white">{direction.title}</h3><p class="mt-2 leading-relaxed text-slate-600 dark:text-slate-400">{direction.question}</p></div>)}</div>
        </Container>
    </section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800 md:py-16" aria-labelledby="teaching-heading">
        <Container size="xl">
            <div class="grid gap-10 md:grid-cols-2">
                <div><h2 id="teaching-heading" class="text-2xl font-semibold text-slate-900 dark:text-white">Teaching & Mentoring</h2><p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-400">As a {teaching.role} at {teaching.organization}, I develop programming materials, deliver teaching and lab sessions, and mentor student software projects.</p><p class="mt-3 text-sm font-medium">{teaching.current}.</p><p class="mt-3 text-sm font-semibold text-brand-700 dark:text-brand-400">{teachingAward.title} · {teachingAward.year}</p><a href="/teaching" class="text-link mt-5 inline-block font-semibold">Courses & teaching experience →</a></div>
                <div><h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Education</h2><ul class="mt-4 space-y-4">{education.map(degree => <li><p class="font-semibold">{degree.degree}, {degree.field}</p><p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{degree.institution}<br />{degree.period}</p></li>)}</ul></div>
            </div>
        </Container>
    </section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800 md:py-16" aria-labelledby="engineering-heading">
        <Container size="xl">
            <SectionHeader id="engineering-heading" title="Research, Grounded in Engineering" description="Nearly five years of professional software engineering before my Ph.D., building backend systems, data pipelines, and production web applications." href="/projects" linkText="Software & research artifacts" />
            <div class="grid gap-6 md:grid-cols-3">{industryExperience.map(role => <div><p class="text-sm text-slate-600 dark:text-slate-400">{role.period}</p><h3 class="mt-1 text-lg font-semibold text-slate-900 dark:text-white">{role.organization}</h3><p class="mt-1 text-sm font-medium">{role.role}</p><p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{role.summary}</p></div>)}</div>
            <a href={PROFILE.RESUME_URL} target="_blank" rel="noopener noreferrer" class="text-link mt-7 inline-block text-sm font-semibold">Industry Research Résumé (PDF)<span class="sr-only"> (opens in a new tab)</span></a>
        </Container>
    </section>
    <ContactCTA />
</PageLayout>
