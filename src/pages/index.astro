---
import Container from "@components/Container.astro";
import ContactCTA from "@components/ContactCTA.astro";
import Icon from "@components/Icon.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ResearchCard from "@components/ResearchCard.astro";
import SectionHeader from "@components/SectionHeader.astro";
import PageLayout from "@layouts/PageLayout.astro";
import type { IconName } from "@types";
import { PROFILE, SITE, SOCIALS } from "@consts";
import { researchProjects } from "@data/research";
import { featuredProjects } from "@data/projects";
import { education, industryExperience, teaching } from "@data/experience";

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: PROFILE.NAME,
    alternateName: PROFILE.PUBLICATION_NAME,
    url: Astro.site,
    image: new URL(PROFILE.PHOTO, Astro.site),
    email: `mailto:${PROFILE.EMAIL}`,
    jobTitle: PROFILE.HEADLINE,
    affiliation: { "@type": "CollegeOrUniversity", name: PROFILE.AFFILIATION },
    alumniOf: [
        { "@type": "CollegeOrUniversity", name: "Wayne State University" },
        { "@type": "CollegeOrUniversity", name: "Jahangirnagar University" },
    ],
    knowsAbout: [
        "Blockchain security",
        "Smart contract security",
        "Privacy-preserving systems",
        "Programmable accounts",
        "Zero-knowledge proofs",
        "Software engineering",
    ],
    sameAs: SOCIALS.filter((social) => !social.HREF.startsWith("mailto:")).map((social) => social.HREF),
};

const secondaryLinks = SOCIALS.filter((social) => social.ICON !== "email");
const iconFor = (icon: string) => (icon === "google-scholar" ? "scholar" : icon) as IconName;

const [phd, ...earlierDegrees] = education;
const industryCompanies = industryExperience.map((role) => role.organization).reverse();

const atAGlance = [
    { term: "Now", detail: `${phd.degree}, ${phd.field} · ${phd.institution}` },
    { term: "Before", detail: `5 years as a software engineer in industry · ${industryCompanies.join(", ")}` },
    { term: "Teaching", detail: `${teaching.current} · ${teaching.organization}` },
    { term: "Based in", detail: PROFILE.LOCATION },
];
---

<PageLayout description={SITE.DESCRIPTION}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- 1. Hero -->
    <section class="pb-16 pt-28 md:pb-20 md:pt-36" aria-labelledby="hero-heading">
        <Container size="xl">
            <div class="grid items-center gap-10 lg:grid-cols-[1fr_auto] lg:gap-16">
                <div class="max-w-3xl">
                    <img
                        src={PROFILE.PHOTO}
                        alt={`Portrait of ${PROFILE.NAME}`}
                        width="400"
                        height="400"
                        class="mb-6 size-24 rounded-2xl border border-slate-200 object-cover dark:border-slate-800 lg:hidden"
                    />
                    <h1 id="hero-heading" class="text-4xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-5xl">
                        {PROFILE.NAME}
                    </h1>
                    <p class="mt-3 text-xl font-medium text-slate-700 dark:text-slate-200 md:text-2xl">{PROFILE.HEADLINE}</p>
                    <p class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-sm font-semibold text-brand-700 dark:text-brand-400 md:text-base">
                        {
                            PROFILE.THEMES.map((theme, i) => (
                                <>
                                    {i > 0 && <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>}
                                    <span>{theme}</span>
                                </>
                            ))
                        }
                    </p>
                    <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-400 md:text-lg">
                        I am a Ph.D. candidate in Computer Science at {PROFILE.AFFILIATION}, researching security and privacy
                        in decentralized and programmable systems. Before beginning my Ph.D., I spent five years in industry as a
                        software engineer, building production web applications, backend systems, and APIs.
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a
                            href="/research"
                            class="inline-flex items-center gap-2 rounded-md bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800 dark:bg-brand-600 dark:hover:bg-brand-500"
                        >
                            Explore Research
                        </a>
                        <a
                            href="/projects"
                            class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:border-brand-600 hover:text-brand-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
                        >
                            View Projects
                        </a>
                        <a
                            href={PROFILE.CV_URL}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:border-brand-600 hover:text-brand-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
                        >
                            <Icon name="download" />
                            Download CV
                            <span class="sr-only"> (PDF, opens in a new tab)</span>
                        </a>
                    </div>

                    <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Profiles">
                        {
                            secondaryLinks.map((social) => (
                                <li>
                                    <a
                                        href={social.HREF}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-1.5 font-medium text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-400"
                                    >
                                        <Icon name={iconFor(social.ICON)} />
                                        {social.TEXT}
                                        <span class="sr-only"> (opens in a new tab)</span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="animate hidden lg:block">
                    <img
                        src={PROFILE.PHOTO}
                        alt={`Portrait of ${PROFILE.NAME}`}
                        width="400"
                        height="400"
                        class="size-72 rounded-2xl border border-slate-200 object-cover dark:border-slate-800"
                    />
                </div>
            </div>
        </Container>
    </section>

    <!-- 2. Introduction -->
    <section class="border-t border-slate-200 py-16 dark:border-slate-800 md:py-20" aria-labelledby="about-heading">
        <Container size="xl">
            <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-16">
                <div>
                    <h2 id="about-heading" class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-[1.75rem]">
                        Security research, grounded in engineering
                    </h2>
                    <div class="mt-4 space-y-4 leading-relaxed text-slate-600 dark:text-slate-400 md:text-lg">
                        <p>
                            My research sits at the intersection of security, decentralized systems, protocol design, and
                            cryptographic systems. I am interested in what happens when a guarantee that holds on paper meets
                            real blockchain state, real transactions, and real software.
                        </p>
                        <p>
                            Industry experience shapes how I work. Having built and maintained production systems, I pay close
                            attention to how designs are actually implemented and deployed, and I build prototypes to test ideas
                            rather than stopping at the model.
                        </p>
                    </div>
                </div>
                <dl class="grid content-start gap-4 rounded-xl border border-slate-200 bg-slate-50 p-6 text-sm dark:border-slate-800 dark:bg-slate-900/50">
                    {
                        atAGlance.map((item) => (
                            <div class="grid grid-cols-[5.5rem_1fr] gap-3">
                                <dt class="font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{item.term}</dt>
                                <dd class="text-slate-800 dark:text-slate-200">{item.detail}</dd>
                            </div>
                        ))
                    }
                </dl>
            </div>
        </Container>
    </section>

    <!-- 3. Selected Research -->
    <section class="border-t border-slate-200 py-16 dark:border-slate-800 md:py-20">
        <Container size="xl">
            <SectionHeader
                id="research"
                title="Selected Research"
                description="Security and privacy in decentralized, programmable, and zero-knowledge systems."
                href="/research"
                linkText="Research & publications"
            />
            <div class="grid gap-5 md:grid-cols-2">
                {researchProjects.map((project) => <ResearchCard project={project} />)}
            </div>
        </Container>
    </section>

    <!-- 4. Featured Projects -->
    <section class="border-t border-slate-200 py-16 dark:border-slate-800 md:py-20">
        <Container size="xl">
            <SectionHeader
                id="projects"
                title="Featured Projects & Tools"
                description="Software I have built: web tools people use, installable utilities, and smart-contract and full-stack systems."
                href="/projects"
                linkText="All projects"
            />
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {featuredProjects.map((project) => <ProjectCard project={project} />)}
            </div>
        </Container>
    </section>

    <!-- 5. Industry Experience -->
    <section class="border-t border-slate-200 py-16 dark:border-slate-800 md:py-20">
        <Container size="xl">
            <SectionHeader
                id="experience"
                title="Industry Experience"
                description="Five years of professional software engineering before beginning my Ph.D., building and running production systems."
            />
            <ol class="divide-y divide-slate-200 dark:divide-slate-800">
                {
                    industryExperience.map((role) => (
                        <li class="grid gap-3 py-6 first:pt-0 last:pb-0 md:grid-cols-[12rem_1fr] md:gap-8">
                            <p class="text-sm font-medium tabular-nums text-slate-500 dark:text-slate-400">{role.period}</p>
                            <div class="flex gap-4">
                                {role.logo && (
                                    <img
                                        src={role.logo}
                                        alt=""
                                        width="100"
                                        height="100"
                                        loading="lazy"
                                        class="mt-0.5 size-10 shrink-0 rounded-md border border-slate-200 bg-white object-contain p-0.5 dark:border-slate-700"
                                    />
                                )}
                                <div>
                                    <h3 class="font-semibold text-slate-900 dark:text-white">
                                        {role.role} <span class="font-normal text-slate-500 dark:text-slate-400">at</span> {role.organization}
                                    </h3>
                                    <p class="mt-1 text-slate-600 dark:text-slate-400">{role.summary}</p>
                                    {role.highlights && (
                                        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-600 marker:text-slate-400 dark:text-slate-400">
                                            {role.highlights.map((highlight) => (
                                                <li>{highlight}</li>
                                            ))}
                                        </ul>
                                    )}
                                </div>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </Container>
    </section>

    <!-- 6. Teaching & Education -->
    <section class="border-t border-slate-200 py-16 dark:border-slate-800 md:py-20">
        <Container size="xl">
            <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
                <div>
                    <SectionHeader id="teaching" title="Teaching" />
                    <p class="font-semibold text-slate-900 dark:text-white">{teaching.organization}</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">{teaching.role} · {teaching.period}</p>
                    <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Courses</p>
                    <ul class="mt-2 space-y-2.5">
                        {
                            teaching.courses.map((course) => (
                                <li class="text-sm">
                                    <span class="font-medium text-slate-800 dark:text-slate-200">
                                        {course.code && `${course.code} — `}{course.name}
                                    </span>
                                    <span class="text-slate-500 dark:text-slate-400"> · {course.detail}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div>
                    <SectionHeader id="education" title="Education" />
                    <div class="rounded-xl border border-brand-200 bg-brand-50/60 p-5 dark:border-brand-900 dark:bg-brand-500/5">
                        <p class="font-semibold text-slate-900 dark:text-white">{phd.degree}, {phd.field}</p>
                        <p class="text-sm text-slate-600 dark:text-slate-400">{phd.institution} · {phd.period}</p>
                    </div>
                    <ul class="mt-4 space-y-3 px-1">
                        {
                            earlierDegrees.map((degree) => (
                                <li class="text-sm">
                                    <span class="font-medium text-slate-800 dark:text-slate-200">
                                        {degree.degree} in {degree.field}
                                    </span>
                                    <span class="text-slate-500 dark:text-slate-400"> · {degree.institution}, {degree.period}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </Container>
    </section>

    <!-- 7. Contact -->
    <div class="border-t border-slate-200 dark:border-slate-800">
        <ContactCTA />
    </div>
</PageLayout>
