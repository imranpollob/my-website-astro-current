---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ToolCard from "@components/ToolCard.astro";
import { PROJECTS } from "@consts";

import projectsData from "./projects.json";
import toolsData from "./tools.json";

type Project = (typeof projectsData.portfolio.projects)["Blockchain Engineering"][number];

const flagshipSections = Object.entries(projectsData.portfolio.projects) as [string, Project[]][];

// Online tools first, then installables — each group ordered by its curated priority.
const tools = [...toolsData].sort((a, b) => {
    if (a.type !== b.type) return a.type === "online" ? -1 : 1;
    return a.priority - b.priority;
});
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
    <!-- Page header -->
    <section class="pt-28 pb-12">
        <Container size="xl">
            <div class="animate space-y-4 text-center">
                <div class="text-xl md:text-2xl lg:text-3xl page-heading">{PROJECTS.TITLE}</div>
            </div>
        </Container>
    </section>

    <!-- ── Flagship Projects ───────────────────────────────────────────────── -->
    {
        flagshipSections.map(([label, projects]) => (
            <section class="pb-16" id={label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}>
                <Container size="xl">
                    <div class="animate space-y-6">
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white uppercase">{label}</h2>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            {projects.map((project) => (
                                <ProjectCard
                                    title={project.title}
                                    description={project.description}
                                    image={project.image || undefined}
                                    liveUrl={project.liveUrl || undefined}
                                    repoUrl={project.url}
                                />
                            ))}
                        </div>
                    </div>
                </Container>
            </section>
        ))
    }

    <!-- ── Tools ───────────────────────────────────────────────────────────── -->
    <section class="pb-20" id="tools">
        <Container size="xl">
            <div class="animate space-y-6">
                <div class="space-y-2 text-center">
                    <p class="text-sm uppercase tracking-widest text-brand-600 dark:text-brand-400 font-semibold">
                        Tools
                    </p>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white uppercase">
                        Everyday tools you can actually use
                    </h2>
                    <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
                        Small online utilities and downloadable apps, built to solve one problem well.
                    </p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    {
                        tools.map((tool) => (
                            <ToolCard
                                repo={tool.repo}
                                title={tool.title}
                                subtitle={tool.subtitle}
                                type={tool.type as "online" | "install"}
                                url={tool.url}
                                action={tool.action}
                                image={tool.image}
                            />
                        ))
                    }
                </div>
            </div>
        </Container>
    </section>
</PageLayout>
