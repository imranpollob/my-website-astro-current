---
import Container from "@components/Container.astro";
import ContactCTA from "@components/ContactCTA.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ResourceLinks from "@components/ResourceLinks.astro";
import SectionHeader from "@components/SectionHeader.astro";
import ToolCard from "@components/ToolCard.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { PROJECTS } from "@consts";
import { projectLinks, projectsIn } from "@data/projects";
import { toolCategories, toolsIn } from "@data/tools";
const security = projectsIn("security");
const ai = projectsIn("ai");
---
<PageLayout title={PROJECTS.SEO_TITLE} description={PROJECTS.DESCRIPTION}>
    <section class="pb-12 pt-28 md:pt-32"><Container size="xl">
        <h1 class="page-heading text-4xl">Projects</h1>
        <p class="mt-5 max-w-3xl leading-relaxed text-slate-600 dark:text-slate-300">Software I have built outside my papers: Solidity protocols, small web tools, and a few AI applications.</p>
        <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold"><a class="text-link" href="#engineering">Security & protocols</a><a class="text-link" href="#tools">Developer tools</a><a class="text-link" href="#ai">AI engineering</a></nav>
    </Container></section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800"><Container size="xl">
        <SectionHeader id="engineering" title="Security & Protocol Engineering" description="Solidity protocols, plus a tool for exploring Solidity syntax trees." />
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{security.map(project => <ProjectCard project={project} />)}</div>
    </Container></section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800"><Container size="xl">
        <SectionHeader id="tools" title="Developer Tools & Applications" description="Web tools and apps I have built outside my research." />
        <div class="space-y-8">{toolCategories.map(category => <div><h3 class="text-lg font-semibold text-slate-900 dark:text-white">{category}</h3><div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{toolsIn(category).map(tool => <ToolCard tool={tool} />)}</div></div>)}</div>
    </Container></section>
    <section class="border-t border-slate-200 py-12 dark:border-slate-800"><Container size="xl">
        <SectionHeader id="ai" title="AI Engineering Projects" />
        <ul class="divide-y divide-slate-200 dark:divide-slate-800">{ai.map(project => <li class="grid gap-4 py-5 md:grid-cols-[1fr_auto]"><div><h3 class="font-semibold text-slate-900 dark:text-white">{project.title}</h3><p class="mt-1 max-w-3xl text-sm text-slate-600 dark:text-slate-400">{project.description}</p></div><ResourceLinks links={projectLinks(project)} context={project.title} /></li>)}</ul>
    </Container></section>
    <ContactCTA />
</PageLayout>
