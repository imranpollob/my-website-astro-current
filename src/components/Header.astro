---
import { SITE, LINKS } from "@consts";
import { cn } from "@lib/utils";
import Container from "@components/Container.astro";

const { pathname } = Astro.url;
const section = "/" + (pathname.match(/[^/]+/g)?.[0] ?? "");
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[60] focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-brand-700 focus:shadow"
>
  Skip to content
</a>

<header id="header" class="fixed top-0 z-50 h-16 w-full">
  <Container size="xl">
    <div class="flex h-full items-center justify-between gap-3">
      <a
        href="/"
        class="flex items-center gap-2 font-heading font-semibold tracking-tight text-slate-900 transition-colors hover:text-brand-700 dark:text-white dark:hover:text-brand-400"
      >
        <img src="/logo.svg" alt="" class="hidden h-7 w-auto sm:block" width="480" height="594" />
        <span class="whitespace-nowrap text-base md:text-lg">{SITE.TITLE}</span>
      </a>

      <div class="flex items-center gap-1 sm:gap-2">
        <nav aria-label="Primary">
          <ul class="flex items-center gap-0.5 sm:gap-1">
            {
              LINKS.map((LINK) => {
                const active = !LINK.EXTERNAL && section === LINK.HREF;
                return (
                  <li>
                    <a
                      href={LINK.HREF}
                      target={LINK.EXTERNAL ? "_blank" : undefined}
                      rel={LINK.EXTERNAL ? "noopener noreferrer" : undefined}
                      aria-current={active ? "page" : undefined}
                      class={cn(
                        "flex h-9 items-center rounded-md px-2 text-sm font-medium transition-colors sm:px-3 sm:text-[0.95rem]",
                        active
                          ? "text-brand-700 underline decoration-2 underline-offset-[6px] dark:text-brand-400"
                          : "text-slate-700 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
                      )}
                    >
                      {LINK.TEXT}
                      {LINK.EXTERNAL && <span class="sr-only"> (PDF, opens in a new tab)</span>}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <button
          id="header-theme-button"
          type="button"
          aria-label="Toggle light and dark theme"
          class="flex size-8 items-center justify-center rounded-md p-1.5 stroke-current text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
        >
          <svg class="block size-full dark:hidden" aria-hidden="true">
            <use href="/ui.svg#sun"></use>
          </svg>
          <svg class="hidden size-full dark:block" aria-hidden="true">
            <use href="/ui.svg#moon"></use>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>
