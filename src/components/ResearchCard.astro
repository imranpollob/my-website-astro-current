---
import { researchLinks, researchStatus, type ResearchProject } from "@data/research";
import StatusBadge from "@components/StatusBadge.astro";
import ResourceLinks from "@components/ResourceLinks.astro";
type Props = { project: ResearchProject };
const { project } = Astro.props;
---
<article id={project.slug} class="card relative flex scroll-mt-24 flex-col gap-4 p-6">
    {project.legacyAnchor && <span id={project.legacyAnchor} class="absolute -top-24" aria-hidden="true" />}
    <div><StatusBadge status={researchStatus(project)} /></div>
    <div>
        <h3 class="text-xl font-semibold text-slate-900 dark:text-white"><a href={`/research/${project.slug}/`} class="hover:text-brand-700 dark:hover:text-brand-300">{project.title}</a></h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{project.subtitle}</p>
    </div>
    <p class="flex-1 leading-relaxed text-slate-600 dark:text-slate-300">{project.summary}</p>
    <ResourceLinks links={researchLinks(project).filter(link => link.label !== "DOI")} context={project.title} />
    <a href={`/research/${project.slug}/`} class="text-link text-sm font-semibold">Research details<span class="sr-only">: {project.title}</span> →</a>
</article>
