---
import type { ResearchProject } from "@data/research";
import { publications } from "@data/research";
import type { ResourceLink } from "@types";
import StatusBadge from "@components/StatusBadge.astro";
import ResourceLinks from "@components/ResourceLinks.astro";
import TagList from "@components/TagList.astro";

type Props = {
    project: ResearchProject;
};

const { project } = Astro.props;

const publication = publications.find((paper) => paper.slug === project.publication);

const links: ResourceLink[] = [
    ...(publication ? [{ label: "Publication", href: `#${publication.slug}`, icon: "file" as const }] : []),
    ...(project.links ?? []),
];

const rows = [
    { term: "Problem", detail: project.problem },
    { term: "Approach", detail: project.approach },
    ...(project.contribution ? [{ term: "Contribution", detail: project.contribution }] : []),
    ...(publication ? [{ term: "Publication", detail: `${publication.venue}${publication.status === "in-press" ? " (in press)" : ""}` }] : []),
];
---

<article id={project.slug} class="card scroll-mt-24 p-6 md:p-8" aria-labelledby={`${project.slug}-title`}>
    <header class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
            <h3 id={`${project.slug}-title`} class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-2xl">
                {project.title}
            </h3>
            <p class="mt-1 text-slate-600 dark:text-slate-400">{project.subtitle}</p>
        </div>
        {project.status && <div class="shrink-0"><StatusBadge status={project.status} /></div>}
    </header>

    <dl class="mt-6 grid gap-x-8 gap-y-4 md:grid-cols-[8rem_1fr]">
        {
            rows.map((row) => (
                <>
                    <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 md:pt-0.5">
                        {row.term}
                    </dt>
                    <dd class="leading-relaxed text-slate-700 dark:text-slate-300">{row.detail}</dd>
                </>
            ))
        }
    </dl>

    <div class="mt-6 flex flex-col gap-4 border-t border-slate-100 pt-5 dark:border-slate-800 md:flex-row md:items-center md:justify-between">
        <TagList tags={project.tags} />
        <ResourceLinks links={links} context={project.title} />
    </div>
</article>
