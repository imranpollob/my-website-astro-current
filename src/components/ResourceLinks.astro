---
import type { ResourceLink } from "@types";
import Icon from "@components/Icon.astro";
import { cn } from "@lib/utils";

type Props = {
    links: ResourceLink[];
    // Accessible context, e.g. the project title, appended to each link label.
    context?: string;
    class?: string;
};

const { links, context, class: className } = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href) || href.endsWith(".pdf");
---

{
    links.length > 0 && (
        <ul class={cn("flex flex-wrap gap-2", className)}>
            {links.map((link) => {
                const external = isExternal(link.href);
                return (
                    <li>
                        <a
                            href={link.href}
                            target={external ? "_blank" : undefined}
                            rel={external ? "noopener noreferrer" : undefined}
                            class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2.5 py-1 text-sm font-medium text-slate-700 dark:text-slate-300 hover:border-brand-500 hover:text-brand-700 dark:hover:border-brand-400 dark:hover:text-brand-300 transition-colors"
                        >
                            {link.icon && <Icon name={link.icon} class="size-3.5" />}
                            {link.label}
                            {context && <span class="sr-only">: {context}</span>}
                            {external && <span class="sr-only"> (opens in a new tab)</span>}
                        </a>
                    </li>
                );
            })}
        </ul>
    )
}
