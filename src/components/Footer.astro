---
import { SITE, SOCIALS } from "@consts";
import Container from "@components/Container.astro";
import Icon from "@components/Icon.astro";
import type { IconName } from "@types";

const year = new Date().getFullYear();
const iconFor = (icon: string) => (icon === "google-scholar" ? "scholar" : icon) as IconName;
---

<footer class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
    <Container size="xl">
        <div class="flex flex-col-reverse items-center gap-4 py-6 text-sm text-slate-500 dark:text-slate-400 sm:flex-row sm:justify-between">
            <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
                <span>&copy; {year} {SITE.AUTHOR}</span>
                <span aria-hidden="true">·</span>
                <a href="/legal/privacy-policy-and-terms" class="hover:text-brand-700 dark:hover:text-brand-400">Privacy & Terms</a>
            </p>

            <ul class="flex items-center gap-1" aria-label="Profiles and contact">
                {
                    SOCIALS.map((social) => {
                        const external = !social.HREF.startsWith("mailto:");
                        return (
                            <li>
                                <a
                                    href={social.HREF}
                                    target={external ? "_blank" : undefined}
                                    rel={external ? "noopener noreferrer" : undefined}
                                    aria-label={social.NAME}
                                    class="flex size-9 items-center justify-center rounded-md text-slate-500 transition-colors hover:bg-slate-100 hover:text-brand-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-brand-400"
                                >
                                    <Icon name={iconFor(social.ICON)} class="size-[1.125rem]" />
                                </a>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </Container>
</footer>

<!-- Floating scroll-to-top button -->
<button
    id="back-to-top"
    type="button"
    aria-label="Scroll to top"
    class="pointer-events-none fixed bottom-6 right-6 z-40 rounded-full border border-slate-200 bg-white p-2.5 text-slate-600 opacity-0 shadow-sm transition-opacity duration-300 hover:text-brand-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"
>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stroke-current" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
</button>

<script is:inline>
    function toggleBackToTop() {
        const backToTop = document.getElementById("back-to-top");
        if (!backToTop) return;
        const visible = window.scrollY > 600;
        backToTop.classList.toggle("opacity-0", !visible);
        backToTop.classList.toggle("pointer-events-none", !visible);
        backToTop.tabIndex = visible ? 0 : -1;
    }

    function initializeBackToTop() {
        const backToTop = document.getElementById("back-to-top");
        if (!backToTop) return;
        backToTop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
        window.addEventListener("scroll", toggleBackToTop, { passive: true });
        toggleBackToTop();
    }

    document.addEventListener("astro:after-swap", initializeBackToTop);
    initializeBackToTop();
</script>
