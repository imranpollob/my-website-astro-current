---
import type { ResearchStatus } from "@data/research";
import { cn } from "@lib/utils";

type Props = {
    status: ResearchStatus;
};

const { status } = Astro.props;
---

<span
    class={cn(
        "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold",
        status.kind === "published" &&
            "border-brand-200 bg-brand-50 text-brand-800 dark:border-brand-800 dark:bg-brand-500/10 dark:text-brand-300",
        status.kind === "ongoing" &&
            "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-800 dark:bg-amber-500/10 dark:text-amber-300",
        status.kind === "accepted" &&
            "border-brand-200 bg-white text-brand-800 dark:border-brand-800 dark:bg-slate-900 dark:text-brand-300",
        status.kind === "study" &&
            "border-slate-200 bg-slate-50 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300",
    )}
>
    <span
        class={cn(
            "size-1.5 rounded-full",
            status.kind === "published" && "bg-brand-600",
            status.kind === "ongoing" && "bg-amber-500",
            status.kind === "accepted" && "bg-brand-500",
            status.kind === "study" && "bg-slate-400",
        )}
        aria-hidden="true"
    >
    </span>
    {status.label}
</span>
