---
import type { Project } from "@data/projects";
import { projectLinks } from "@data/projects";
import ResourceLinks from "@components/ResourceLinks.astro";
import TagList from "@components/TagList.astro";

type Props = {
    project: Project;
    // Show the screenshot when the project has one.
    showImage?: boolean;
    headingLevel?: "h3" | "h4";
};

const { project, showImage = false, headingLevel: Heading = "h3" } = Astro.props;
const links = projectLinks(project);
const primaryUrl = links[0]?.href;
---

<article class="card group flex flex-col overflow-hidden">
    {
        showImage && project.image && (
            <div class="aspect-[16/9] overflow-hidden border-b border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900">
                <img
                    src={project.image}
                    alt={`Screenshot of ${project.title}`}
                    class="h-full w-full object-cover object-top"
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="360"
                />
            </div>
        )
    }
    <div class="flex flex-1 flex-col gap-3 p-5">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-400">{project.kind}</p>
            <Heading class="mt-1 text-base font-semibold text-slate-900 dark:text-white">
                {
                    primaryUrl ? (
                        <a href={primaryUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-700 dark:hover:text-brand-300">
                            {project.title}
                        </a>
                    ) : (
                        project.title
                    )
                }
            </Heading>
        </div>
        <p class="flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{project.description}</p>
        {
            project.platforms && (
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    <span class="font-semibold text-slate-700 dark:text-slate-300">Builds:</span> {project.platforms}
                </p>
            )
        }
        {
            project.installCommand && (
                <code class="block overflow-x-auto whitespace-nowrap rounded-md border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-xs text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                    <span class="select-none text-slate-400" aria-hidden="true">$ </span>
                    {project.installCommand}
                </code>
            )
        }
        <TagList tags={project.tags} />
        <ResourceLinks links={links} context={project.title} class="pt-1" />
    </div>
</article>
