---
import Container from "@components/Container.astro";
import { SOCIALS } from "@consts";

type Props = {
    heading?: string;
    subheading?: string;
};

const {
    heading = "Let's build secure and intelligent systems",
    subheading = "Open to roles in Blockchain, AI/ML, and Software Engineering",
} = Astro.props;
---

<section id="contact" class="pb-20 animate">
    <Container size="xl">
        <div
            class="relative overflow-hidden p-8 md:p-10 rounded-2xl border border-brand-700/20 bg-gradient-to-br from-brand-600 to-brand-800 space-y-6"
        >
            <div class="space-y-2">
                <p class="text-sm uppercase tracking-widest text-brand-200 font-semibold">Contact</p>
                <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
                    {heading}
                </h2>
                <p class="text-base md:text-lg text-brand-100">
                    {subheading}
                </p>
            </div>

            <div
                class="flex flex-col md:flex-row flex-wrap md:items-center gap-4 text-sm md:text-base text-white"
            >
                {
                    SOCIALS.map((social) => (
                        <a
                            href={social.HREF}
                            target="_blank"
                            rel="noreferrer"
                            class="flex items-center gap-2 px-3 py-2 rounded-full border border-white/20 bg-white/10 hover:bg-white/20 transition-colors"
                        >
                            <span class="inline-flex items-center justify-center rounded-full border border-white/20 p-1">
                                <svg class="size-4 fill-current">
                                    <use href={`/social.svg#${social.ICON}`} />
                                </svg>
                            </span>
                            <span class="font-semibold text-white">{social.TEXT}</span>
                        </a>
                    ))
                }
            </div>
        </div>
    </Container>
</section>
