---
import Container from "@components/Container.astro";
import Icon from "@components/Icon.astro";
import type { IconName } from "@types";
import { PROFILE, SOCIALS } from "@consts";

type Props = {
    heading?: string;
    subheading?: string;
};

const {
    heading = "Contact",
    subheading = "I'm glad to hear about research collaborations, academic positions, and industry research or engineering roles.",
} = Astro.props;

const email = SOCIALS.find((social) => social.ICON === "email")!;
const profiles = SOCIALS.filter((social) => social.ICON !== "email");
const iconFor = (icon: string) => (icon === "google-scholar" ? "scholar" : icon) as IconName;
---

<section id="contact" class="scroll-mt-20 py-16 md:py-20" aria-labelledby="contact-heading">
    <Container size="xl">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/50 md:p-10">
            <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
                <div class="max-w-xl">
                    <h2 id="contact-heading" class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white md:text-[1.75rem]">
                        {heading}
                    </h2>
                    <p class="mt-2 text-slate-600 dark:text-slate-400">{subheading}</p>
                    <a
                        href={email.HREF}
                        class="mt-5 inline-flex items-center gap-2 text-lg font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:decoration-brand-600 dark:text-brand-400"
                    >
                        <Icon name="email" class="size-5" />
                        {email.TEXT}
                    </a>
                </div>
                <ul class="flex flex-wrap gap-2 md:justify-end">
                    {
                        profiles.map((social) => (
                            <li>
                                <a
                                    href={social.HREF}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-brand-500 hover:text-brand-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:text-brand-300"
                                >
                                    <Icon name={iconFor(social.ICON)} />
                                    {social.TEXT}
                                    <span class="sr-only"> (opens in a new tab)</span>
                                </a>
                            </li>
                        ))
                    }
                    <li>
                        <a
                            href={PROFILE.CV_URL}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-brand-500 hover:text-brand-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:text-brand-300"
                        >
                            <Icon name="file" />
                            CV (PDF)
                            <span class="sr-only"> (opens in a new tab)</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </Container>
</section>
